{
  "name": "dispatch-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The Dispatch landing page: a static site built with Vite and React.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "app": "node scripts/build-app.mjs",
    "dev": "node scripts/build-app.mjs && vite",
    "build": "node scripts/build-app.mjs && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.5"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dispatch",
  "version": "0.1.6",
  "identifier": "com.darkconstant.dispatch",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Dispatch",
        "width": 1040,
        "height": 660,
        "minWidth": 820,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/dispatch"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyQkEzNzFBQTEwMDMzMUEKUldRYU13Q2hHamU2SXV0dGNiMkNOSWkzaytYeFhodWZybzlKS0xFZGQ4RFVsT1RQMDNJOS9WaVoK",
      "endpoints": ["https://github.com/IvyYang1999/dispatch/releases/latest/download/latest.json"]
    }
  }
}
